# Copy to .env for the tooling under scripts/. The library itself reads no environment
# variables, and the offline tests need none of these.

# a proxy for every request the tooling makes, both protocols
# RDAP_WHOIS_PROXY=http://user:pass@host:port

# or a rotating proxy: WHOIS through its SOCKS5 side, RDAP through its HTTP CONNECT side
# PROXY_USERNAME_DEFAULT=
# PROXY_PASSWORD_DEFAULT=
# PROXY_HOST=p.webshare.io
# PROXY_PORT=80
